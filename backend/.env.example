# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/jadvix_certificate?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
COOKIE_NAME=jadvix_session
# Set to false when serving over plain HTTP (Elastic IP without SSL). Set to
# true (or leave unset in production) once HTTPS is configured.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── CORS ──────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000

# ── Security tunables ─────────────────────────────────────────────────────
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── Public URL ────────────────────────────────────────────────────────────
PUBLIC_API_URL=http://localhost:8000
